package platform-sprinter

# Self-disabled: only activated via -p platform-sprinter when building
# the disk image for the Sprinter target.
disable-pkg platform-sprinter

# Stock init with one console; /etc/rc waits for writable-root validation.
r /init
f 0755 /init          ../../../Applications/util/init
f 0644 /etc/inittab   inittab

# Keep the verified V7 fsh for the login shell.
r /bin/sh
f 0755 /bin/sh        ../../../Applications/V7/cmd/sh/fsh
