package platform-sprinter

# Self-disabled: only activated via -p platform-sprinter when building
# the disk image for the Sprinter target.
disable-pkg platform-sprinter

# Temporary bring-up override: boot into a tiny Sprinter-only userspace probe
# instead of the full SysV-style /init. Current probe is a pure Z80 assembly
# binary with no libc/crt0 dependencies, used to validate the bare
# kernel->userspace transition without any syscall/runtime complexity.
r /init
f 0755 /init          ../../../Applications/util/sprinit0
