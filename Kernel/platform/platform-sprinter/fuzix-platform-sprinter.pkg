package platform-sprinter

# Self-disabled: only activated via -p platform-sprinter when building
# the disk image for the Sprinter target.
disable-pkg platform-sprinter

# Temporary bring-up override: boot into a tiny Sprinter-only userspace probe
# instead of the full SysV-style /init. Current probe is a tiny C binary that
# performs one minimal syscall and then loops, used to validate the first
# user->kernel->user round-trip without dragging in full init/stdio logic.
r /init
f 0755 /init          ../../../Applications/util/sprinit
